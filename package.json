{
  "name": "monzo-pebble",
  "author": "BenBJD",
  "version": "1.2.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {},
  "pebble": {
    "displayName": "Monzo",
    "uuid": "f4bf3afe-bfe4-4c3c-8607-2fb45c00524f",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "aplite",
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint",
      "gabbro"
    ],
    "watchapp": {
      "watchface": false
    },
    "usesPermissions": [
      {
        "name": "Internet",
        "parameters": {
          "domains": [
            "api.monzo.com"
          ]
        },
        "reason": "To fetch Monzo account balances, pots, and transactions",
        "required": true
      }
    ],
    "configPage": "src/config.html",
    "messageKeys": [
      "KEY_THEME",
      "KEY_ACCOUNT_COUNT",
      "KEY_STATUS",
      "KEY_REQUEST_TYPE",
      "KEY_ACC0_ID",
      "KEY_ACC0_NAME",
      "KEY_ACC0_BALANCE",
      "KEY_ACC0_SPEND",
      "KEY_ACC0_TOTAL",
      "KEY_ACC0_POTS",
      "KEY_ACC1_ID",
      "KEY_ACC1_NAME",
      "KEY_ACC1_BALANCE",
      "KEY_ACC1_SPEND",
      "KEY_ACC1_TOTAL",
      "KEY_ACC1_POTS",
      "KEY_ACC2_ID",
      "KEY_ACC2_NAME",
      "KEY_ACC2_BALANCE",
      "KEY_ACC2_SPEND",
      "KEY_ACC2_TOTAL",
      "KEY_ACC2_POTS",
      "KEY_ACC3_ID",
      "KEY_ACC3_NAME",
      "KEY_ACC3_BALANCE",
      "KEY_ACC3_SPEND",
      "KEY_ACC3_TOTAL",
      "KEY_ACC3_POTS"
    ],
    "resources": {
      "media": []
    }
  }
}
